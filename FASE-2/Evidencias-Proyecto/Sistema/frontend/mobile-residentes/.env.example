# Copia este archivo como .env (no se sube al repositorio) y ajusta la URL.
# URL de la API, sin "/" al final. En el celular NO sirve "localhost": usa la IP de Tailscale
# del equipo donde corre el backend (el celular también debe tener Tailscale encendido).
#   EXPO_PUBLIC_API_URL=http://100.92.132.127:3000
# Si cambias este valor, reinicia Expo con: npx expo start --clear
EXPO_PUBLIC_API_URL=http://100.92.132.127:3000
