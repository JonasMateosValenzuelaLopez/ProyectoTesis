# Copia este archivo como .env (no se sube al repositorio) y ajusta la URL.
# URL de la API, sin "/" al final:
# - backend en este mismo equipo: http://localhost:3000
# - backend en otro equipo por Tailscale: http://<IP de Tailscale de ese equipo>:3000
# Si cambias este valor, reinicia "npm run dev".
VITE_API_URL=http://localhost:3000
