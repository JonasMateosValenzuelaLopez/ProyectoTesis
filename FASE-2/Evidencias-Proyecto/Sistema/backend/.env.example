PORT=3000
# development | production. Solo con "development" se imprimen en consola los
# correos cuando no hay SMTP (incluyen enlaces para cambiar contraseñas).
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=entrecasas_db

JWT_SECRET=
JWT_EXPIRES_IN=1h

# Orígenes permitidos para CORS (panel web, Expo web), separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# URL del panel web; se usa para armar los enlaces de los correos
FRONTEND_URL=http://localhost:5173

# Correo saliente (SMTP). Si SMTP_HOST queda vacío no se envían correos:
# con NODE_ENV=development se imprimen en consola; si no, solo se registra un error.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EntreCasas <no-responder@entrecasas.cl>

# Solo en producción detrás de un proxy (Render): número entero de proxies
# delante de la API. Vacío o 0 = sin proxy. Otro valor detiene el arranque.
TRUST_PROXY=
