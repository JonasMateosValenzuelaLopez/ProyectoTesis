# Las reglas sin "/" inicial aplican en cualquier carpeta del repositorio
# (backend, frontend/web-admin, frontend/mobile-residentes, etc.).

# Dependencias
node_modules/

# Compilados y builds
dist/
dist-ssr/
build/
web-build/
coverage/
*.tsbuildinfo

# Expo / React Native
.expo/
expo-env.d.ts
.metro-health-check*
.kotlin/

# Variables de entorno (secretos). Solo se sube el ejemplo.
.env
.env.*
!.env.example

# Certificados y llaves
*.pem
*.key
*.jks
*.p8
*.p12
*.mobileprovision

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Archivos temporales de Office (se crean al tener un documento abierto)
~$*

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores
.idea/
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/extensions.json

# Contexto local para Claude Code
claude.md
CLAUDE.md
.claude/
